# 对外访问地址，用于分享卡片和搜索引擎元数据。
# 有域名时填写 https://study.example.com；使用服务器 IP 时可填写 http://1.2.3.4:3000
SITE_URL=http://localhost:3000

# 映射到服务器的端口。
APP_PORT=3000

# 可选：用于每日任务编排。密钥只在服务端使用，不会发送到浏览器。
# 不填写时会自动使用内置的人工审核题库，所有学习活动仍可正常使用。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
