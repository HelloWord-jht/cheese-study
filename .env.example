# 对外访问地址，用于分享卡片和搜索引擎元数据。
# 有域名时填写 https://study.example.com；使用服务器 IP 时可填写 http://1.2.3.4:3000
SITE_URL=http://localhost:3000

# 仅监听本机，由服务器 Nginx 对外反向代理。
BIND_ADDRESS=127.0.0.1

# 映射到服务器的端口。
APP_PORT=3000

# 可选：用于每日任务编排。密钥只在服务端使用，不会发送到浏览器。
# 不填写时会自动使用内置的人工审核题库，所有学习活动仍可正常使用。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 家长 AI 助手默认供应商：deepseek 或 openai。
AI_DEFAULT_PROVIDER=deepseek

# 可选：配置后家长中心可切换到 GPT。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# 可选：豆豆龙 AI 自然声。与家长 GPT 助手共用 OPENAI_API_KEY。
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin
